{
    "ct_1_3_security_modes_tests": {
        "Notes": [
            "Test 1.3: Client Connectivity - Security Modes.",
            "18 suite entries = 6 security modes x 3 bands (2g/5g/6g).",
            "Suite key format: 1_3_{case_id}_{band} -- matched by test_1_3_security_modes.py.",
            "sta_connect2.py drives: open / wpa2-psk / wpa3-sae-h2e / wpa2-wpa3-transition / owe.",
            "test_ipv4_ttls.py drives: wpa3-enterprise (enabled=FALSE until RADIUS is available).",
            "6G open and 6G wpa2-psk are disabled: Wi-Fi 6E/7 mandates WPA3/OWE on 6 GHz.",
            "Radio mapping: wiphy0=2.4G, wiphy1=5G, wiphy2=6G -- update after confirming AT7 layout.",
            "LF_MGR_IP / UPSTREAM_PORT / REPORT_PATH / TEST_RIG are substituted by lf_check.py",
            "from the rig JSON; pytest LANforgeRunner inlines them from the environment YAML."
        ]
    },
    "test_suites": {

