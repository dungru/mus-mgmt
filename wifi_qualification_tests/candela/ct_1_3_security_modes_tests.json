                "args":      "",
                "args_list": [
                    "--mgr LF_MGR_IP",
                    "--upstream_port UPSTREAM_PORT",
                    "--local_lf_report_dir REPORT_PATH",
                    "--radio 1.1.wiphy0",
                    "--dut_ssid MTK-Test-2G",
                    "--dut_passwd [BLANK]",
                    "--dut_security open",
                    "--num_stations 64",
                    "--test_rig TEST_RIG",
                    "--test_tag 1.3_open_2g",
                    "--dut_model_num MTK7999-AP"
